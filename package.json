{
  "name": "devcamp2-backend",
  "version": "0.0.1",
  "description": "DevCamp 2 Final Project — Personalized Code Learning Platform (Backend)",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-content.ts",
    "seed:dry": "tsx scripts/seed-content.ts --dry-run",
    "seed:reset": "tsx scripts/seed-content.ts --reset",
    "backup": "tsx scripts/backup-db.ts",
    "fix-indexes": "tsx scripts/fix-userroadmap-indexes.ts",
    "backfill:shared-progress": "tsx scripts/backfill-shared-topic-progress.ts",
    "backfill:shared-progress:dry": "tsx scripts/backfill-shared-topic-progress.ts --dry-run",
    "prepare": "husky"
  },
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "csv-parse": "^6.2.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "openai": "^6.46.0",
    "pino": "^10.3.1",
    "resend": "^6.12.3",
    "zod": "^4.3.6"
  }
}
