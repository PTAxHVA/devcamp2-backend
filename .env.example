NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/devcamp2

# JWT (generate >=32 chars: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-32-char-string-or-longer-for-security
JWT_EXPIRES_IN=7d

# Fireworks AI (OpenAI-compatible LLM provider) — https://app.fireworks.ai
FIREWORKS_API_KEY=your-fireworks-key
# Optional (has a default): model id is swappable without a code change.
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b

# CORS
CLIENT_URL=http://localhost:5173

# Resend API
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# Secrets hygiene
#  - Never commit a real .env. Only this .env.example (placeholders) is tracked.
#  - All vars above except NODE_ENV / PORT / JWT_EXPIRES_IN / CLIENT_URL /
#    FIREWORKS_MODEL are required; boot fails fast via src/config/env.ts if any
#    is missing/invalid.
#  - If a secret is ever exposed, ROTATE it immediately:
#      JWT_SECRET   -> openssl rand -base64 48  (rotating invalidates all sessions)
#      MONGO_URI    -> reset the DB user password in Atlas, update Render env
#      FIREWORKS_API_KEY / RESEND_API_KEY -> revoke + reissue in the provider console
#  - Production values live ONLY in the host dashboards (Render for BE, Vercel for FE).
# ---------------------------------------------------------------------------