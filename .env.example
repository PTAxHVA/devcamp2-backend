NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/devcamp2

# JWT (generate >=32 chars: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-32-char-string-or-longer-for-security
JWT_EXPIRES_IN=7d

# Google Gemini
GEMINI_API_KEY=your-gemini-key

# CORS
CLIENT_URL=http://localhost:5173
